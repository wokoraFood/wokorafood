# Local SQLite (default). For production Postgres (Neon/Railway/Render):
# 1) set provider = "postgresql" in prisma/schema.prisma
# 2) use a connection string such as:
# DATABASE_URL="postgresql://wokora:wokora@localhost:5432/wokorafoods?schema=public"
DATABASE_URL="file:./dev.db"

# NextAuth
NEXTAUTH_URL="http://localhost:3001"
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Wokora Foods <hello@wokorafoods.com>"
NEXTAUTH_SECRET="replace-with-a-long-random-string"

# Optional Google login
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# Receipt printing
# kiosk  = Approach 3 (default) — admin kiosk tab auto-opens print dialog
# agent  = Approach 1 — POST to a local print-agent on the cafe LAN
# escpos = Approach 2 — raw ESC/POS over TCP (cloud / VPN printer)
PRINT_MODE="kiosk"
PRINT_AGENT_URL="http://127.0.0.1:4100"
PRINT_AGENT_SECRET="replace-with-a-print-agent-secret"
PRINTER_IP=""
PRINTER_PORT="9100"

# Optional WhatsApp Cloud API (notification stub)
WHATSAPP_NOTIFY="false"
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
